[Unit]
Description=nerd-dictation daemon
Documentation=https://github.com/marcusmae/nerd-dictation
After=pipewire.service pipewire-pulse.service sound.target graphical-session-pre.target
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=@ABS_INSTALL_PREFIX@/bin/nerd-dictation daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment="XDG_RUNTIME_DIR=%t"
Environment="DISPLAY=:0"
Environment="LD_LIBRARY_PATH=@ABS_INSTALL_PREFIX@/lib:@ABS_INSTALL_PREFIX@/lib/res_embed"

# Security. No filesystem namespacing (PrivateTmp, ProtectSystem,
# ProtectHome, ReadWritePaths): in a user service it needs a user namespace,
# where root's files appear owned by "nobody", and ssh - which the "remote"
# backend runs - then refuses /etc/ssh/ssh_config.d ("Bad owner").
NoNewPrivileges=true

# Resource limits
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=default.target
