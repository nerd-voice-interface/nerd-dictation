[Unit]
Description=nerd-dictation daemon
Documentation=https://github.com/marcusmae/nerd-dictation-ex
After=pipewire.service pipewire-pulse.service sound.target
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=@ABS_INSTALL_PREFIX@/bin/nerd-dictation daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Окружение
Environment="XDG_RUNTIME_DIR=%t"

# Безопасность
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/nerd-dictation %h/.local/share/vosk %h/.local/share/nerd-dictation %t

# Ограничения ресурсов
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=default.target
