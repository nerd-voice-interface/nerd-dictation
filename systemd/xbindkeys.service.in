[Unit]
Description=X11/Wayland key binding daemon for nerd-dictation
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/xbindkeys
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
# xbindkeys may exit immediately if no config or in non-graphical session
# This is normal behavior - service will restart when needed

[Install]
WantedBy=default.target
